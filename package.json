{
  "name": "prettypkg",
  "version": "1.2.15",
  "description": "A command-line utility to format package.json files consistently",
  "keywords": [
    "package",
    "formatter",
    "prettier"
  ],
  "license": "MIT",
  "author": "Róbert Darida",
  "homepage": "https://rdarida.github.io/prettypkg/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdarida/prettypkg.git"
  },
  "bugs": {
    "url": "https://github.com/rdarida/prettypkg/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "files": [
    "./dist"
  ],
  "scripts": {
    "lint": "tsc",
    "prettier": "prettier . --check",
    "pretest": "rimraf ./coverage",
    "test": "vitest",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "release:dryrun": "release-it --dry-run",
    "predocs": "rimraf ./docs",
    "docs": "typedoc"
  },
  "dependencies": {
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.2",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-istanbul": "^5.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-brace-style": "^0.10.3",
    "release-it": "^21.1.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
